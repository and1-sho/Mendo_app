<div class="text-center h-fit min-h-svh grid place-content-center py-8 md:pt-6 lg:py-12 lg:pt-16 xl:pt-8">
  <h1 class="text-center text-[24px] font-extrabold tracking-[0.08em] text-neutral-900 md:text-[32px] md:tracking-[0.14em] lg:text-[30px] xl:text-[32px]"><span class="text-accent">商品番号</span>を入力してください</h1>

  <%# 入力された番号を表示するエリア %>
  <p class="text-[72px] text-orange-400 font-bold tracking-[0.04em] my-6 pb-6 pl-1 md:text-[136px] md:tracking-widest md:pl-4 lg:text-[120px] lg:my-0 lg:py-2 xl:pt-6 xl:pb-10" id="display">-</p>

  <%# 決定ボタンを押すとフォームをサーバーに送信する %>
  <%= form_with url: inputs_path, method: :post, id: "numpad-form" do |f| %>
    <%# JSで数字を入れる隠しフィールド %>
    <%= f.hidden_field :item_code, id: "item-code-input", value: "" %>

    <article class="max-w-[300px] grid grid-cols-3 gap-3 text-4xl font-semibold w-lg mx-auto md:gap-6 md:text-6xl md:max-w-none lg:scale-90 xl:scale-100">
      <%# テンキーのボタン配置 %>
      <button class="cursor-pointer bg-white rounded-lg shadow-card aspect-11/7 js-button" type="button" onclick="addNumber('1')">1</button>
      <button class="cursor-pointer bg-white rounded-lg shadow-card aspect-11/7 js-button" type="button" onclick="addNumber('2')">2</button>
      <button class="cursor-pointer bg-white rounded-lg shadow-card aspect-11/7 js-button" type="button" onclick="addNumber('3')">3</button>
      <button class="cursor-pointer bg-white rounded-lg shadow-card aspect-11/7 js-button" type="button" onclick="addNumber('4')">4</button>
      <button class="cursor-pointer bg-white rounded-lg shadow-card aspect-11/7 js-button" type="button" onclick="addNumber('5')">5</button>
      <button class="cursor-pointer bg-white rounded-lg shadow-card aspect-11/7 js-button" type="button" onclick="addNumber('6')">6</button>
      <button class="cursor-pointer bg-white rounded-lg shadow-card aspect-11/7 js-button" type="button" onclick="addNumber('7')">7</button>
      <button class="cursor-pointer bg-white rounded-lg shadow-card aspect-11/7 js-button" type="button" onclick="addNumber('8')">8</button>
      <button class="cursor-pointer bg-white rounded-lg shadow-card aspect-11/7 js-button" type="button" onclick="addNumber('9')">9</button>
      <div class="empty"></div>
      <button class="cursor-pointer bg-white rounded-lg shadow-card aspect-11/7 js-button" type="button" onclick="addNumber('0')">0</button>

      <%# 1文字消すボタン %>
      <button class="cursor-pointer scale-65 mx-auto md:scale-100 js-button" data-sound="delete" type="button" onclick="deleteNumber()">
        <svg width="89" height="57" viewBox="0 0 89 57" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M21.6367 2.5H86C86.2761 2.5 86.5 2.72386 86.5 3V54C86.5 54.2761 86.2761 54.5 86 54.5H21.5732C21.4135 54.5 21.263 54.424 21.1689 54.2949L3.26465 29.7344C3.14027 29.5638 3.13621 29.3328 3.25488 29.1582L21.2227 2.71875C21.3157 2.58186 21.4712 2.5 21.6367 2.5Z" fill="#7C7C7C" stroke="#7C7C7C" stroke-width="5"/>
          <path d="M63 17L39 41" stroke="white" stroke-width="5"/>
          <path d="M39 17L63 41" stroke="white" stroke-width="5"/>
        </svg>
      </button>
    </article>

    <%# 決定ボタン（フォームを送信する） %>
    <div class="w-74 mx-auto md:w-141 md:grid md:grid-cols-2 md:w-160 md:gap-x-8  md:mt-18 lg:grid-cols-1 lg:grid-row-2 lg:mt-0 lg:gap-y-6 lg:w-68 lg:absolute lg:bottom-8 lg:right-8 xl:w-80 xl:right-20 xl:bottom-20">
      <button class="cursor-pointer bg-accent py-5 pl-6 mt-14 w-full max-w-lg text-[26px] text-white font-extrabold tracking-[.6em] rounded-xl md:mt-0 md:py-6 md:py-9 md:text-4xl md:col-start-2 lg:row-start-1 lg:col-start-1 js-button lg:text-[28px] xl:text-3xl" data-sound="confirm" type="submit"><span>決定</span></button>

      <p class="text-[24px] mt-4 bg-white text-accent font-extrabold border-[2.5px] border-accent tracking-[.1em] rounded-xl js-button md:mt-0 md:text-3xl md:border-[3px] md:col-start-1 md:row-start-1 lg:row-start-2 lg:text-[26px]"><a class="block w-full h-full py-5 md:py-9" data-sound="delete" href="<%= root_path %>" data-turbo="false">スキャンに戻る</a></p>
    </div>
  <% end %>

</div>

<script>
  // 入力された番号を画面に表示する関数
  function addNumber(num) {
    var input = document.getElementById('item-code-input');
    var display = document.getElementById('display');

    // 最大8桁まで入力できる
    if (input.value.length >= 8) return;

    input.value += num;
    display.textContent = input.value;
  }

  // 1文字消す関数
  function deleteNumber() {
    var input = document.getElementById('item-code-input');
    var display = document.getElementById('display');

    input.value = input.value.slice(0, -1);

    // 何も入力されていない場合は「-」を表示する
    display.textContent = input.value || '-';
  }
</script>
