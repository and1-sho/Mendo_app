<%# 管理画面：削除済み備品（見た目はスタッフ担当。クラスは付けない） %>

<h1>削除済み</h1>

<p>
  <%= link_to "在庫一覧に戻る", admin_stocks_path %>
  <%= link_to "備品一覧に戻る", admin_items_path %>
</p>

<% if @items.empty? %>
  <p>削除済みの備品はありません</p>
<% else %>
  <table>
    <thead>
      <tr>
        <th>商品番号</th>
        <th></th>
        <th>備品名</th>
        <th>在庫数</th>
        <th>削除日時</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @items.each do |item| %>
        <tr>
          <td><%= item.item_code %></td>
          <td>
            <% if item.image_displayable? %>
              <%= image_tag item.image, width: 60 %>
            <% end %>
          </td>
          <td><%= item.name %></td>
          <td><%= item.stock %></td>
          <td><%= l(item.discarded_at, format: :long) %></td>
          <td>
            <%= button_to "復元する", restore_admin_discarded_item_path(item), method: :patch %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%= paginate @items, window: 1, outer_window: 1 %>
<% end %>
