<%# バーコードスキャン画面（見た目・カメラはスタッフ担当。クラスは付けない） %>

<div class="px-8 md:px-0 md:w-[568px] mx-auto relative pb-16 lg:w-[648px] lg:pb-8">
  <h1 class="text-[28px] pt-20 pb-14 text-center md:text-4xl font-extrabold tracking-widest md:pt-28 md:pb-22 lg:pt-24 lg:pb-23">バーコードスキャン</h1>

  <div class="relative">
    <video id="barcode-camera" autoplay playsinline muted class="w-full h-80 rounded-xl bg-neutral-200"></video>

    <div class="absolute inset-0 flex items-center justify-center text-neutral-500">
      カメラ準備中
    </div>
  </div>

  <p class="w-74 mx-auto md:w-141 md:w-160 md:mt-18 lg:w-68 xl:w-80>
    <a href="<%= manual_input_path %>" class="cursor-pointer bg-accent py-5 pl-6 mt-14 w-full max-w-lg text-[26px] text-white font-extrabold tracking-[.6em] rounded-2xl md:mt-0 md:py-6 md:py-9 md:text-4xl js-button lg:text-[28px] xl:text-3xl" data-sound="confirm">手入力する</a>
  </p>

  <form id="scan-form" action="<%= items_scan_path %>" method="post">
    <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
    <input type="hidden" name="staff_id" id="staff-id-field" value="">

    <label>
      バーコード（確認用）
      <input type="text" name="barcode" id="barcode-input" autocomplete="off">
    </label>

    <button type="submit">スキャンする</button>
  </form>

  <p id="scan-message"></p>
</div>

<script>
  (function () {
    var staffId = localStorage.getItem("staff_id");

    // staff_id がなければ初回の名前登録へ
    if (!staffId) {
      window.location.replace("<%= new_staff_path %>");
      return;
    }

    var field = document.getElementById("staff-id-field");
    if (field) {
      field.value = staffId;
    }

    // fetch で JSON API も叩けるようにする（カメラ実装時に利用）
    window.mendoScanBarcode = function (barcode) {
      var tokenMeta = document.querySelector('meta[name="csrf-token"]');
      var token = tokenMeta ? tokenMeta.getAttribute("content") : "";
      var sid = localStorage.getItem("staff_id");

      return fetch("<%= items_scan_path %>", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "Accept": "application/json",
          "X-CSRF-Token": token
        },
        body: JSON.stringify({ barcode: barcode, staff_id: sid })
      }).then(function (res) {
        return res.json().then(function (data) {
          return { ok: res.ok, data: data };
        });
      });
    };
  })();
</script>
