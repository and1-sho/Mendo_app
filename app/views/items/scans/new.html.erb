<%# バーコードスキャン画面（見た目・カメラはスタッフ担当。クラスは付けない） %>

<%= turbo_page_requires_reload %>

<div class="px-8 md:px-0 md:w-[648px] mx-auto relative pb-16 lg:w-[800px] lg:pb-20" data-controller="barcode">
  <h1 class="text-[28px] pt-20 pb-14 text-center md:text-4xl font-extrabold tracking-widest md:pt-28 md:pb-22 lg:pt-24 lg:pb-22 xl:pb-23">バーコードスキャン</h1>

  <div class="relative">
    <video id="barcode-camera" data-barcode-target="video" autoplay playsinline muted class="w-full h-100 rounded-xl bg-neutral-200 object-cover md:h-170 lg:h-100 xl:h-100"></video>

    <div data-barcode-target="loading" class="absolute inset-0 flex items-center justify-center text-neutral-500 tracking-[0.1em] md:text-2xl">
      カメラ準備中
    </div>
  </div>

  <p class="mx-auto w-full h-fit mt-14 md:mt-18 lg:mt-14">
    <a href="<%= manual_input_path %>" class="cursor-pointer block text-[19px] full py-5 text-center md:w-[330px] h-[68px] rounded-xl md:h-auto md:py-9 md:mx-auto md:text-3xl tracking-widest bg-orange-400 font-extrabold text-white lg:w-[330px] lg:py-8 lg:bottom-8 js-button" data-sound="confirm">手入力する</a>
  </p>

  <div class="border-t border-neutral-300 mt-14 mb-12 lg:mt-22 lg:mb-16"></div>

  <form id="scan-form" class="" action="<%= items_scan_path %>" method="post">
    <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
    <input type="hidden" name="staff_id" id="staff-id-field" value="">

    <label class="mb-6 w-full md:w-[265px] lg:w-105.5 lg:mb-8">
      <span class="block mb-2 text-sm font-semibold tracking-[0.02em] md:text-lg md:mb-4">バーコード（確認用）</span>
      <input type="text" name="barcode" id="barcode-input" autocomplete="off" class="form-input focus:outline-none focus:border-[#021b15] tracking-[0.06em] mb-7 h-[50px] md:mb-8 md:h-[60px] md:text-xl lg:mb-10 focus:shadow-[0_0_0_3px_rgba(2,27,21,0.12)]">
    </label>

    <button type="submit" class="cursor-pointer text-[19px] w-full mt-4 h-[68px] rounded-xl tracking-widest bg-white border-[2px] border-orange-400 text-orange-400 font-extrabold grid place-items-center md:mx-auto md:w-[308px] md:border-[3px] md:text-2xl md:h-auto md:py-7 js-button">スキャンする</button>
  </form>

  <p id="scan-message"></p>
</div>

<script>
  (function () {
    var staffId = localStorage.getItem("staff_id");

    // staff_id がなければ初回の名前登録へ
    if (!staffId) {
      window.location.replace("<%= new_staff_path %>");
      return;
    }

    var field = document.getElementById("staff-id-field");
    if (field) {
      field.value = staffId;
    }

    // fetch で JSON API も叩けるようにする（カメラ実装時に利用）
    window.mendoScanBarcode = function (barcode) {
      var tokenMeta = document.querySelector('meta[name="csrf-token"]');
      var token = tokenMeta ? tokenMeta.getAttribute("content") : "";
      var sid = localStorage.getItem("staff_id");

      return fetch("<%= items_scan_path %>", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "Accept": "application/json",
          "X-CSRF-Token": token
        },
        body: JSON.stringify({ barcode: barcode, staff_id: sid })
      }).then(function (res) {
        return res.json().then(function (data) {
          return { ok: res.ok, data: data };
        });
      });
    };
  })();
</script>
