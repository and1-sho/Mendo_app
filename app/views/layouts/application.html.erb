<!DOCTYPE html>
<html>
  <head>
    <title>MendoApp</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

    <!-- Googleフォント｜ Noto Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">

    <script src="https://unpkg.com/@zxing/browser@0.2.1"></script>

    <%= javascript_importmap_tags %>
  </head>

  <body class="font-sans" data-click-sound="<%= asset_path('click.mp3') %>"
    data-delete-sound="<%= asset_path('delete.mp3') %>"
    data-confirm-sound="<%= asset_path('confirm.mp3') %>"
    data-scan-sound="<%= asset_path('scan.mp3') %>">
    <%# フラッシュメッセージ（数秒後に自動で消える） %>
    <% if flash[:notice] %>
      <p id="flash-notice" class="text-center text-white text-lg leading-[1.8] font-medium tracking-widest p-8 bg-success md:text-xl md:p-11"><%= flash[:notice] %></p>
    <% end %>
    <% if flash[:alert] %>
      <p id="flash-alert" class="text-center text-white text-lg leading-[1.8] font-medium tracking-widest p-8 bg-error md:text-xl md:p-11"><%= flash[:alert] %></p>
    <% end %>

    <%= yield %>
  </body>
</html>