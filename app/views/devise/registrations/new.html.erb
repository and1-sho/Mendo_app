<div class="w-screen h-svh relative mt-16 md:mt-35 lg:mt-26 xl:mt-20">
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-90 h-fit py-9 px-7 rounded-2xl bg-white shadow-card border-[1px] border-neutral-300 sm:w-115">
    <h1 class="mb-[30px] text-2xl font-bold text-center tracking-[0.02em]">アカウント登録</h1>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "flex flex-col" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="mb-[18px] relative">
        <%= f.label :email, "メールアドレス", class: "block mb-2 text-sm font-semibold" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-input focus:outline-none focus:border-[#021b15] focus:shadow-[0_0_0_3px_rgba(2,27,21,0.12)]" %>
      </div>

      <div class="mb-[18px] relative">
        <%= f.label :password, "パスワード", class: "block mb-2 text-sm font-semibold" %>
        <%= f.password_field :password, autocomplete: "new-password", class: "form-input focus:outline-none focus:border-[#021b15] focus:shadow-[0_0_0_3px_rgba(2,27,21,0.12)]" %>
      </div>

      <div class="mb-[18px] relative">
        <%= f.label :password_confirmation, "パスワード（確認）", class: "block mb-2 text-sm font-semibold" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-input focus:outline-none focus:border-[#021b15] focus:shadow-[0_0_0_3px_rgba(2,27,21,0.12)]" %>
      </div>

      <%= f.submit "登録する", class: "cursor-pointer bg-orange-400 py-3 px-[18px] w-full h-[54px] text-white text-lg font-extrabold tracking-[0.08em] rounded-[10px] mt-2 js-button", data: { sound: "confirm" } %>
    <% end %>

    <div class="mt-6 mx-auto w-fit js-button">
      <%= link_to "ログインはこちら", new_user_session_path, class: "inline-block text-sm font-semibold underline underline-offset-3" %>
    </div>
  </div>
</div>
