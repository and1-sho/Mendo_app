<%= turbo_frame_tag "modal" do %>
  <div class="w-[360px] p-4 mx-auto mx-auto bg-white tracking-[0.08em] items-center rounded-lg shadow-card relative md:w-[500px] md:p-6">
    <div class="grid grid-cols-2 md:gap-4 lg:gap-2">
      <div class="rounded-lg relative w-36 h-36 bg-neutral-300 overflow-hidden md:w-50 md:h-50">
        <% if item.image_displayable? %>
          <%= image_tag item.image, width: 60, class: "w-full h-full object-cover" %>
        <% else %>
          <div class="absolute w-full h-full inset-0 grid place-items-center">
            <span class="text-neutral-500 md:text-[18px]">画像なし</span>
          </div>
        <% end %>
      </div>
      <div class="pl-[2px]">
        <div class="flex justify-between">
          <p class="text-[18px] md:text-[24px] lg:text-[20px]"><%= item.item_code %></p>
        </div>
        <p class="py-[6px] leading-[1.2] tracking-[0.08em] mb-2 md:text-[22px] md:py-3 md:mb-3 lg:py-4 lg:mb-2"><%= item.name %></p>
        <p class="flex justify-between tracking-[0.04em] text-[16px] leading-[1.55] items-center md:text-[18px] text-accent md:mb-1"><span class="text-[13px] font-semibold md:text-[16.5px]">在庫数</span><span class="text-accent font-semibold"><%= item.stock %></span></p>
        <p class="flex justify-between tracking-[0.04em] text-[16px] leading-[1.55] items-center md:text-[18px] md:mb-1"><span class="text-[13px] md:text-[16.5px]">注文トリガー数</span><span><%= item.order_trigger %></p>
        <p class="flex justify-between tracking-[0.04em] text-[16px] leading-[1.55] items-center md:text-[18px]"><span class="text-[13px] md:text-[16.5px]">目標補充数</span><span><%= item.reorder_quantity %></span></p>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-x-2 items-center justify-between mt-4 tracking-widest md:gap-x-3 lg:mt-5">
      <%= link_to "入庫する", new_admin_item_stock_receipt_path(item), class: "text-sm font-semibold icon-button bg-orange-400 py-3 text-white text-center rounded-lg md:text-[18px] md:py-4 js-button", data: { sound: "confirm", turbo_frame: "_top" } %>
      <%= button_to admin_item_path(item),
        method: :delete,
        form: { data: { turbo_confirm: "削除してよいですか？", turbo_frame: "_top" } },
        data: { sound: "delete" },
        class: "cursor-pointer text-sm font-semibold icon-button bg-white py-[10px] text-accent border-[1.5px] border-orange-400 w-full rounded-lg md:text-[18px] md:py-[14px] js-button" do %>
        <span>削除する</span>
      <% end %>
    </div>

    <%= link_to edit_admin_item_path(item),
        class: "absolute top-[14px] right-[14px] lg:top-[18px] lg:right-[18px] js-button", data: { sound: "confirm", turbo_frame: "_top" } do %>
      <svg width="24" height="23" viewBox="0 0 26 25" fill="none" class="md:w-[29px] md:h-[31px]" xmlns="http://www.w3.org/2000/svg">
        <path d="M9.25 3.34766H2.75C1.64543 3.34766 0.75 4.24309 0.75 5.34766V21.8477C0.75 22.9522 1.64543 23.8477 2.75 23.8477H20.75C21.8546 23.8477 22.75 22.9522 22.75 21.8477V15.3477" stroke="#000000" stroke-width="1.5"/>
        <path d="M8.75 12.3477L12.25 16.3477M18.663 2.84766L20.5431 1.0308C20.9354 0.651634 21.5593 0.656966 21.9451 1.04278L24.0429 3.14055C24.4334 3.53107 24.4334 4.16424 24.0429 4.55476L22.0403 6.55738L12.25 16.3477L7.25 17.3477L8 14.8477L8.75 12.3477L18.663 2.84766ZM22.0403 6.55738L18.663 2.84766" stroke="#000000" stroke-width="1.5"/>
      </svg>
    <% end %>

  </div>
<% end %>