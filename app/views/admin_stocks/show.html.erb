<%# 管理画面：備品詳細（見た目はスタッフ担当。クラスは付けない） %>

<h1>詳細</h1>

<p>商品番号: <%= @item.item_code %></p>
<p>
  <% if @item.image_displayable? %>
    <%= image_tag @item.image, width: 200 %>
  <% else %>
    画像なし
  <% end %>
</p>
<p>備品名: <%= @item.name %></p>
<p>在庫数: <%= @item.stock %></p>
<p>注文トリガー数: <%= @item.order_trigger %></p>
<p>目標補充数: <%= @item.reorder_quantity %></p>

<p>
  <%= link_to "入庫", new_admin_item_stock_receipt_path(@item) %>
  <%= link_to "編集する", edit_admin_item_path(@item) %>
</p>

<p><%= link_to "在庫一覧に戻る", admin_stocks_path %></p>
