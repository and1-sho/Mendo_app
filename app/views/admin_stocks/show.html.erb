<%# 管理画面：備品詳細（見た目はスタッフ担当。クラスは付けない） %>

<div class="relative min-h-svh">
  <h1 class="text-center text-[28px] pt-22 pb-18 font-extrabold tracking-widest md:text-4xl md:pt-28 md:pb-22 lg:pt-20 lg:pb-18">詳細</h1>

  <article class="w-screen h-full bg-neutral-100 pt-10 pb-14 ">
    <%= render "item_detail", item: @item %>
  </article>
  <p class="flex justify-center my-8 mx-auto">
    <%= link_to "在庫一覧に戻る", admin_stocks_path,
      data: { sound: "delete" },
      class: "inline-block text-xm text-center font-semibold icon-button bg-orange-400 py-3 border-[1.5px] text-white border-orange-400 w-45 rounded-lg js-button", data: { sound: "confirm" } %>
  </p>
</div>
